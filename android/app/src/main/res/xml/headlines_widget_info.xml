<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis redraws "Updated X min ago" only. It never fetches. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="320dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="270dp"
    android:targetCellWidth="4"
    android:targetCellHeight="5"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_headlines"
    android:previewLayout="@layout/widget_preview"
    android:previewImage="@drawable/widget_preview_image"
    android:description="@string/widget_description"
    android:configure="com.grs.news.widget.WidgetConfigActivity"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
